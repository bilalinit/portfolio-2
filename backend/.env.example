# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Gemini's OpenAI-compatible endpoint + model (defaults shown; override to
# point the same agent at any OpenAI-compatible provider)
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_NAME=gemini-3.6-flash

# Comma-separated origins allowed to call the API (the Next.js dev site)
ALLOWED_ORIGINS=http://localhost:3000

# Server bind (defaults shown)
HOST=0.0.0.0
PORT=8000
